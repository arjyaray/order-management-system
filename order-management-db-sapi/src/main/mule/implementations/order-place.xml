	<sub-flow name="order-placeSub_Flow" doc:id="4eecfbc8-b8ec-440b-98bf-cd7c4d3655ad">

    <logger level="INFO"
            doc:name="Log-OrderPlaceStart"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[SAPI][ORDER] Place request | orderId: '&#10;   ++ payload.orderId&#10;   ++ ' | sku: ' ++ payload.sku&#10;   ++ ' | qty: ' ++ (payload.quantity as String)]"/>

    <set-variable
        variableName="orderPayload"
        value="#[payload]"
        doc:name="Var-StoreOrderPayload"/>

    <!-- STEP 1: Decrement stock FIRST — atomically -->
    <db:update config-ref="MySQL_DB_Config"
               doc:name="DB-DecrementStock">
        <db:sql><![CDATA[
            UPDATE inventory
            SET    available_quantity = available_quantity - :qty
            WHERE  sku = :sku
            AND    available_quantity >= :qty
        ]]></db:sql>
        <db:input-parameters><![CDATA[#[{
    sku: vars.orderPayload.sku,
    qty: vars.orderPayload.quantity
}]]]></db:input-parameters>
    </db:update>

    <choice doc:name="Choice-WasStockDecremented">

        <when expression="#[payload.affectedRows &gt; 0]">

            <db:insert config-ref="MySQL_DB_Config"
                       doc:name="DB-InsertOrderRecord">
                <db:sql><![CDATA[
                    INSERT INTO orders
                        (order_id, phone_number, sku,
                         quantity, order_channel,
                         payment_mode, delivery_pref, status)
                    VALUES
                        (:orderId, :phoneNumber, :sku,
                         :quantity, :orderChannel,
                         :paymentMode, :deliveryPref, 'PLACED')
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{
                    orderId:      vars.orderPayload.orderId,
                    phoneNumber:  vars.orderPayload.phoneNumber,
                    sku:          vars.orderPayload.sku,
                    quantity:     vars.orderPayload.quantity,
                    orderChannel: vars.orderPayload.orderChannel
                                  default "UNKNOWN",
                    paymentMode:  vars.orderPayload.paymentMode
                                  default "UNKNOWN",
                    deliveryPref: vars.orderPayload.deliveryPreference
                                  default "STANDARD"
                }]]]></db:input-parameters>
            </db:insert>

            <ee:transform doc:name="Transform-SuccessResponse">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: true,
    orderId: vars.orderPayload.orderId,
    sku:     vars.orderPayload.sku
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </when>

        <otherwise>
            <ee:transform doc:name="Transform-OutOfStockResponse">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    success: false,
    sku:     vars.orderPayload.sku,
    reason:  "OUT_OF_STOCK"
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </otherwise>

    </choice>

</sub-flow>


</mule>
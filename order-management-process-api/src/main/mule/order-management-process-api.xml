<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <apikit:config name="order-management-process-api-config" api="resource::4b52cd00-ad97-4956-a3d7-70a467f5a4fc:order-management-process-api:1.0.0:raml:zip:order-management-process-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="order-management-process-api-main">
        <http:listener doc:name="Listener" doc:id="c58a44e3-6621-4a9b-ab8a-6e03a6806ef5" config-ref="HTTP_Listener_config" path="${http.listener.path}">
			<http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<apikit:router config-ref="order-management-process-api-config" />
		<error-handler ref="global-error-handler" />
    </flow>
    <flow name="post:\orders:application\json:order-management-process-api-config">
	<logger
            level="INFO"
            doc:name="Log-OrdersRequestReceived"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[PAPI][ORDER] Request received | correlationId: ' ++ correlationId]"/>
        <flow-ref
            name="placeOrdersSubFlow"
            doc:name="Ref-PlaceOrdersSubFlow"/>
        <logger
            level="INFO"
            doc:name="Log-OrdersResponseSent"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[PAPI][ORDER] Response sent | status: ' ++ payload.requestStatus&#10;   ++ ' | correlationId: ' ++ correlationId]"/>
    </flow>
    <flow name="post:\stock\availability:application\json:order-management-process-api-config">
		<logger
            level="INFO"
            doc:name="Log-StockRequestReceived"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[PAPI][STOCK] Request received | correlationId: '&#10;                       ++ correlationId]"/>
        <flow-ref
            name="stockAvailabilitySubFlow"
            doc:name="Ref-StockAvailabilitySubFlow"/>
        <logger
            level="INFO"
            doc:name="Log-StockResponseSent"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[PAPI][STOCK] Response sent | correlationId: '&#10;   ++ correlationId]"/>
    </flow>
</mule>

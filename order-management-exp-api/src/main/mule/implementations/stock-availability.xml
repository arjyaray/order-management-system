<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <sub-flow name="stockAvailabilityExpSubFlow">

        <set-variable
            variableName="stockRequest"
            value="#[payload]"
            doc:name="Var-StoreStockRequest"/>

        <logger
            level="INFO"
            doc:name="Log-ForwardingStockCheck"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[EAPI][STOCK] Forwarding to Process API'&#10;   ++ ' | skuCount: ' ++ (sizeOf(vars.stockRequest.skus) as String)&#10;   ++ ' | correlationId: ' ++ correlationId]"/>

        <http:request
            config-ref="ProcessAPI_Request_Config"
            path="${process.api.basePath}/stock/availability"
            method="POST"
            doc:name="HTTP-ForwardStockCheckToProcessAPI">
            <http:body><![CDATA[#[vars.stockRequest]]]></http:body>
            <http:headers><![CDATA[#[{
                "Content-Type":     "application/json",
                "x-correlation-id": correlationId
            }]]]></http:headers>
        </http:request>

        <logger
            level="INFO"
            doc:name="Log-StockResponseReceived"
            message="#[%dw 2.0&#10;output application/json&#10;---&#10;'[EAPI][STOCK] Response received from Process API | '&#10;   ++ 'resultCount: ' ++ (sizeOf(payload.stock) as String)&#10;   ++ ' | correlationId: ' ++ correlationId]"/>

    </sub-flow>

</mule>